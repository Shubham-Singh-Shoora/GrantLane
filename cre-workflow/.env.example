# Key the CRE CLI signs with: workflow deployment, and the real transactions
# `cre workflow simulate --broadcast` sends on Base Sepolia (so the address
# needs a little Base Sepolia ETH).
CRE_ETH_PRIVATE_KEY=0x...
# API key for non-interactive CLI use (alternative to `cre login`).
CRE_API_KEY=
# RPC used for the workflow registry chain.
ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
