# ---------------------------------------------------------------------------
# GrantLane - copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- World ID / IDKit -------------------------------------------------------
# From the World Developer Portal. Public: shipped to the browser.
NEXT_PUBLIC_WORLD_APP_ID=app_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Action configured in the Developer Portal for milestone / payout-wallet checks.
NEXT_PUBLIC_WORLD_ACTION=grantlane-payout-wallet

# World ID 4.x requires a registered Relying Party. IDKit's `rp_context` is an
# ECDSA signature over (nonce, created_at, expires_at, action) produced by
# @worldcoin/idkit-server's signRequest(). Both values are SERVER-ONLY.
WORLD_RP_ID=rp_xxxxxxxxxxxxxxxx
WORLD_RP_SIGNING_KEY=0x...            # hex private key registered against WORLD_RP_ID

# Developer Portal API key, used by the server when calling the verify endpoint.
WORLD_DEV_PORTAL_API_KEY=

# Selfie Check is beta-gated: email developers@toolsforhumanity.com to have it
# enabled for the app id above before the selfieCheckLegacy preset will work.

# --- Arc Testnet ------------------------------------------------------------
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_RPC_URL=https://rpc.testnet.arc.io

# Deployed GrantEscrow (set after running contracts/script/Deploy.s.sol).
NEXT_PUBLIC_GRANT_ESCROW_ADDRESS=0x...
# ERC-20 USDC used as the escrow asset on Arc Testnet.
NEXT_PUBLIC_USDC_ADDRESS=0x...

# --- Deployment (contracts/) ------------------------------------------------
DEPLOYER_PRIVATE_KEY=0x...
# CRE KeystoneForwarder on Arc Testnet (chain selector "arc-testnet").
KEYSTONE_FORWARDER=0x76c9cf548b4179F8901cda1f8623568b58215E62
# Address matching ATTESTOR_PRIVATE_KEY below.
ATTESTOR_ADDRESS=0x...
# Optional: restrict accepted reports to one workflow owner.
EXPECTED_WORKFLOW_OWNER=

# --- Attestor (server) ------------------------------------------------------
# Signs the EIP-712 PayoutWalletChange struct after a Selfie Check proof
# verifies. Must correspond to ATTESTOR_ADDRESS. SERVER-ONLY.
ATTESTOR_PRIVATE_KEY=0x...

# --- CRE --------------------------------------------------------------------
# Used by the CRE CLI to sign workflow registration//deployment. SERVER-ONLY.
CRE_ETH_PRIVATE_KEY=0x...
# Workflow name registered with CRE; the web app polls executions by this name.
CRE_WORKFLOW_NAME=grant-evaluation-workflow
CRE_WORKFLOW_OWNER=0x...
