# ---------------------------------------------------------------------------
# GrantLane — copy to .env and fill in. Never commit the filled-in file.
#
# This root .env is read by Foundry scripts and the demo tooling. The web app
# reads apps/web/.env.local instead; the values marked [web] go there too (and
# into the Vercel project settings — see DEPLOYMENT.md).
# ---------------------------------------------------------------------------

# --- World ID / IDKit [web] ------------------------------------------------
# From the World Developer Portal. Public: shipped to the browser.
NEXT_PUBLIC_WORLD_APP_ID=app_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GrantLane asks for proof of a live human at three moments, each with its own
# action so a proof gathered for one cannot be replayed at another:
#   grantlane-application    — before an application is accepted (anti-bot)
#   grantlane-milestone      — before a milestone claim can be signed
#   grantlane-payout-wallet  — before the payout wallet can be changed
# These are used automatically. If your Developer Portal requires actions to be
# pre-registered one by one and you only have one, set the single action here and
# WORLD_SINGLE_ACTION=true to route all three through it.
NEXT_PUBLIC_WORLD_ACTION=grantlane-payout-wallet
WORLD_SINGLE_ACTION=false

# World ID 4.x requires a registered Relying Party. IDKit's `rp_context` is an
# ECDSA signature over (nonce, created_at, expires_at, action) produced by
# @worldcoin/idkit-server's signRequest(). Both values are SERVER-ONLY.
WORLD_RP_ID=rp_xxxxxxxxxxxxxxxx
WORLD_RP_SIGNING_KEY=0x...            # hex private key registered against WORLD_RP_ID

# Developer Portal API key, used by the server when calling the verify endpoint.
WORLD_DEV_PORTAL_API_KEY=

# --- Base Sepolia [web] -----------------------------------------------------
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_GRANT_ESCROW_ADDRESS=0x85AC2a3e1EBc0959599025eB6eF36eD34c862840
# Circle USDC — the escrow asset, the claim bond and the dispute bond.
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Optional: shown on the admin page. The CRE workflow writes settlements through it.
NEXT_PUBLIC_SETTLEMENT_RECEIVER_ADDRESS=0x5c7f09FDf7bC860AF7F0C5EcBD220B3391583a95
# Public URL of the deployed app. Evidence links written into UMA claims use it;
# unset, they use whatever host served the request (localhost in development).
NEXT_PUBLIC_APP_URL=

# --- Access [web] -----------------------------------------------------------
# Wallets that may see the granter/reviewer UI (comma-separated). UI segregation
# only — see apps/web/lib/access.ts for what it is and is not worth.
NEXT_PUBLIC_GRANTER_ADDRESSES=0x30411b981578Fad62D4D20316Da8936cE61F8509

# --- Attestor [web, server-only] ---------------------------------------------
# Signs the EIP-712 MilestoneClaim and PayoutWalletChange structs after a Selfie
# Check verifies, and the HMAC verification tickets. Must match ATTESTOR_ADDRESS.
ATTESTOR_PRIVATE_KEY=0x...
# Optional: sign tickets with a separate secret instead of the attestor key.
GRANTLANE_TICKET_SECRET=

# --- Misc [web] -------------------------------------------------------------
# Optional. Repo lookups on the application form are unauthenticated (public
# repos only); a token raises the 60-requests/hour anonymous rate limit.
GITHUB_TOKEN=
# Local file store location. Defaults to apps/web/.data. Never set on Vercel —
# there the store is Redis (KV_REST_API_URL / KV_REST_API_TOKEN, injected).
GRANTLANE_DATA_DIR=

# --- Contracts (Foundry) ----------------------------------------------------
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org   # also switches the fork tests on
DEPLOYER_PRIVATE_KEY=0x...
ATTESTOR_ADDRESS=0x...
# Deploy.s.sol defaults, overridable:
# UMA_OOV3_ADDRESS=0x0F7fC5E6482f096380db6158f978167b57388deE
# USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# LIVENESS_SECONDS=300          # 5-minute demo window; 172800 for 48 hours
# BOND_AMOUNT=1000000           # 1 USDC
# DeploySettlementReceiver.s.sol defaults to the simulation MockKeystoneForwarder:
# CRE_FORWARDER_ADDRESS=0x82300bd7c3958625581cc2f77bc6464dcecdf3e5

# --- Demo script (contracts/script/Demo.s.sol) -------------------------------
GRANT_ESCROW_ADDRESS=0x85AC2a3e1EBc0959599025eB6eF36eD34c862840
APPLICANT_ADDRESS=0x...
APPLICANT_PRIVATE_KEY=0x...     # a throwaway test wallet — remove when done
